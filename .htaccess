<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow direct access to run-setup.php
    RewriteCond %{REQUEST_URI} ^/run-setup\.php [NC]
    RewriteRule ^ - [L]

    # Redirect all other traffic to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
